# Токен бота от @BotFather
BOT_TOKEN=

# ID чата администратора для уведомлений (узнать: отправьте боту /myid)
ADMIN_CHAT_ID=

# --- MAX (необязательно): тот же бот в мессенджере MAX, расписание общее с Telegram ---
# Токен из кабинета MAX для бизнеса: business.max.ru → Чат-боты → Настройки
MAX_BOT_TOKEN=
# ID администратора в MAX (узнать: отправьте боту в MAX /myid)
MAX_ADMIN_ID=

TIMEZONE=Europe/Moscow

# ИИ-провайдер: none | openai | anthropic | gigachat
#   none       — без ИИ, поиск по FAQ (работает сразу, ключ не нужен)
#   openai     — OpenAI и любые совместимые API (Groq, OpenRouter, Gemini...)
#   anthropic  — Claude API (по умолчанию claude-haiku-4-5)
#   gigachat   — GigaChat
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Для «думающих» моделей (gpt-oss): low | medium | high
LLM_REASONING_EFFORT=

# --- Готовые пресеты (раскомментируйте один и вставьте ключ) ---

# Groq — бесплатно, без карты, ~1000 запросов/день. Ключ: https://console.groq.com/keys
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=low

# OpenRouter — бесплатные модели с суффиксом :free, 50 запросов/день. Ключ: https://openrouter.ai/keys
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=<модель из https://openrouter.ai/models?q=free>
